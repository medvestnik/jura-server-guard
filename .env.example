APP_NAME="Jura Server Guard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8765
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jura_server_guard
DB_USERNAME=jsg
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# SQLite alternative for local/small installs:
# DB_CONNECTION=sqlite
# DB_DATABASE=/opt/jura-server-guard/storage/database.sqlite
JURA_ADMIN_EMAIL=admin@example.com
# Web panel language: ru, uk, or en. Can be overridden per-browser from the panel's language switcher.
JURA_DEFAULT_LOCALE=ru
JURA_PHP_BIN=
JURA_BIND_HOST=127.0.0.1
JURA_PORT=8765
JURA_SCAN_ROOTS=/var/www
JURA_SITE_PATTERN=/var/www/*/data/www/*
JURA_QUARANTINE_PATH=/root/jura-server-guard/quarantine
JURA_WEB_ACTIONS_ENABLED=false
JURA_SCAN_INTERVAL_MINUTES=30
JURA_SCAN_OLD_DUBL_BY_DEFAULT=false
JURA_SCAN_STORAGE_BY_DEFAULT=false
JURA_HASH_ALL_FILES=false
JURA_MAX_FILE_READ_BYTES=262144
JURA_OPENAI_ENABLED=false
JURA_OPENAI_API_KEY=
# Telegram alerts:
# 1) create a bot with @BotFather and copy the token into JURA_TELEGRAM_BOT_TOKEN;
# 2) send any message to the bot;
# 3) open https://api.telegram.org/bot<TOKEN>/getUpdates and copy message.chat.id into JURA_TELEGRAM_CHAT_ID;
# 4) run: php artisan guard:telegram-test --message="Jura Server Guard test".
JURA_TELEGRAM_ENABLED=false
JURA_TELEGRAM_BOT_TOKEN=
JURA_TELEGRAM_CHAT_ID=
JURA_NOTIFY_NEW_CRITICAL_HIGH_FINDINGS=true
JURA_NOTIFY_UNTRUSTED_WEBROOT_FILES=true
JURA_NOTIFY_CRON_CHANGES=true
JURA_CRON_MONITOR_ENABLED=true
# Host security monitors. Install systemd units with: sudo bash bin/install-security-monitors.sh
JURA_SSH_KEY_MONITOR_FILES=/root/.ssh/authorized_keys,/var/www/*/data/.ssh/authorized_keys
JURA_SSH_KEY_MONITOR_STATE=/opt/jura-server-guard/storage/ssh-key-monitor/authorized_keys_state.json
JURA_USER_CRON_MONITOR_FILES=/var/spool/cron/*,/var/spool/cron/crontabs/*,/etc/crontab,/etc/cron.d/*,/etc/cron.hourly/*,/etc/cron.daily/*,/etc/cron.weekly/*,/etc/cron.monthly/*
JURA_USER_CRON_MONITOR_STATE=/opt/jura-server-guard/storage/user-cron-monitor/state.json
JURA_PROCESS_MONITOR_STATE=/opt/jura-server-guard/storage/process-monitor/state.json
JURA_PROCESS_MONITOR_INCLUDE_INFO=false
# Optional PCRE to suppress known local false positives in process monitor, e.g. #/backup-agent|node exporter/#
JURA_PROCESS_MONITOR_IGNORE_REGEX=
